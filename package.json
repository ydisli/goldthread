{
  "name": "throughline",
  "version": "0.1.0",
  "private": true,
  "description": "Throughline \u2014 the intent & alignment layer for Product Owners and Business Analysts",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "tl": "cli/tl.ts"
  },
  "scripts": {
    "dev": "node server/index.ts --dev",
    "build": "vite build --config web/vite.config.ts",
    "start": "node server/index.ts",
    "test": "node --test \"core/test/*.test.ts\" \"server/test/*.test.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "seed": "node server/index.ts --reset-only",
    "tl": "node cli/tl.ts",
    "reset-password": "node server/index.ts --reset-password",
    "e2e": "playwright test -c e2e/playwright.config.ts",
    "backup": "node server/index.ts --backup"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
